# ===== FLOCH BOT — salin ke .env lalu isi =====
# Server
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000
# Set true jika diakses lewat HTTPS (cookie Secure + HSTS)
COOKIE_SECURE=false
# Jika di belakang reverse proxy (Nginx/Cloudflare): 1
TRUST_PROXY=0
DATA_DIR=./data
TZ_DEFAULT=Asia/Jakarta
# Kosongkan agar dibuat otomatis di data/.session_secret
SESSION_SECRET=

# Owner bot: nomor WhatsApp (digit, kode negara, tanpa +), pisahkan koma. WAJIB diisi agar ada Owner.
OWNER_NUMBERS=628xxxxxxxxxx
# Role yang boleh memakai command Premium tanpa langganan (default: owner)
PREMIUM_BYPASS_ROLES=owner
ADMIN_CAN_MANAGE_PREMIUM=false
OWNER_BYPASS_GROUP_ADMIN=true

# Website pairing
# Kode akses opsional agar orang asing tidak bisa menyambungkan nomor lewat website kamu
PAIRING_ACCESS_CODE=
MAX_SESSIONS=3
PAIRING_RATE_PER_10MIN=5
API_RATE_PER_MIN=120
# Jeda minimum antar command per pengguna (ms)
COMMAND_COOLDOWN_MS=1000
VISITOR_TTL_DAYS=365
WA_LOG_LEVEL=silent

# Limit harian
DAILY_LIMIT_FREE=30
DAILY_LIMIT_PREMIUM=300
DAILY_BONUS_FREE=10
DAILY_BONUS_PREMIUM=30
GAME_LIMIT_FREE=20
GAME_LIMIT_PREMIUM=100

# Menu: gambar Floch (WAJIB kamu sediakan sendiri; tidak disertakan). Format jpg/png.
MENU_IMAGE_PATH=./public/assets/floch-menu.jpg
MENU_SHOW_RESTRICTED=false

# Info lain
DONATION_INFO=
SOURCE_URL=

# JWS (Premium). Jalankan `npm run check:jws` setelah mengisi; command baru aktif jika lolos.
JWS_API_URL=https://randomwaifu.com/get/api/
# Jika API membalas JSON, isi path ke URL gambar, mis. data.url (kosongkan untuk deteksi otomatis)
JWS_JSON_PATH=
JWS_TIMEOUT_MS=10000
JWS_MAX_BYTES=8000000
JWS_ALLOW_HTTP=false

# AI (opsional; format OpenAI-compatible). Command aktif hanya jika key terisi.
AI_DEFAULT_PROVIDER=gpt
AI_TIMEOUT_MS=30000
AI_MAX_CONTEXT=10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GEMMA_API_KEY=
# LLM lokal/lainnya (mis. Ollama)
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
